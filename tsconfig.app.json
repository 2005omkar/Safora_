{
  "compilerOptions": {
    "composite": true,
    "ignoreDeprecations": "5.0",
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
  "@/*": ["./src/*"]
}
  },
  "include": ["src"]
}
